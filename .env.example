# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=

# ── App / Server ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# ── Auth ──────────────────────────────────────────────────────────────────────
# Must be at least 32 characters in production.
JWT_SECRET=
JWT_EXPIRES_IN=7d
EMAIL_VERIFICATION_TTL_HOURS=24

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Placeholder value disables delivery (a warning is logged at boot).
RESEND_API_KEY=
EMAIL_FROM=Physio <no-reply@mail.physio.local>

# ── Video (Daily.co) ─────────────────────────────────────────────────────────
# VIDEO_PROVIDER: DAILY (default) or IN_HOUSE
VIDEO_PROVIDER=DAILY
DAILY_API_KEY=
DAILY_DOMAIN=

# ── Payments (Paystack) ───────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# PAYSTACK_TEST_BYPASS=1  — only valid when NODE_ENV=test or development
# Hard ceiling: 1000 bps (10%). The app throws at boot if this exceeds 1000.
PLATFORM_FEE_BPS=1000

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Proxy / Rate-limiting ─────────────────────────────────────────────────────
# Shared secret between the Next.js proxy and the API for verified client-IP forwarding.
PROXY_SHARED_SECRET=

# ── Admin seed (one-off; never commit values) ─────────────────────────────────
# Usage: ADMIN_EMAIL=... ADMIN_PASSWORD=... pnpm --filter @physio/db seed
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Pre-launch access gate (web app) ─────────────────────────────────────────
# When set, sign-up/login buttons on the landing page require this code.
# Leave blank to disable the gate (dev default).
ACCESS_CODE=

# ── Next.js public vars (web app) ─────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_PATIENTS=
NEXT_PUBLIC_WHATSAPP_PHYSIO=
NEXT_PUBLIC_WHATSAPP_SPEECH=
NEXT_PUBLIC_WHATSAPP_OT=
NEXT_PUBLIC_WHATSAPP_PROSTHETIST=
NEXT_PUBLIC_WHATSAPP_ORTHOTIST=
