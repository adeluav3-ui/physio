generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────

enum Discipline {
  PHYSIOTHERAPY
  OCCUPATIONAL_THERAPY
  SPEECH_THERAPY
  PROSTHETICS
  ORTHOTICS
}

enum ReferralStatus {
  SENT
  PATIENT_CONSENTED
  ACCEPTED
  DECLINED
  BOOKED
  SESSION_HELD
  SUMMARY_SENT
  CONFIRMED
  CLOSED
  EXPIRED
}

enum ReferralUrgency {
  ROUTINE
  SOON
  URGENT
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  PAUSED
  CANCELLED
}

enum PlanType {
  EXERCISE    // physiotherapy
  GOAL        // occupational therapy, speech therapy
}

enum Role {
  PATIENT
  PHYSIO
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum LicenceStatus {
  UNVERIFIED
  VERIFIED
  REJECTED
  EXPIRED
}

enum TriageLevel {
  GREEN
  FLAG
  IN_PERSON_REQUIRED
}

enum AppointmentType {
  ASSESSMENT
  FOLLOW_UP
  REASSESSMENT
  HOME_VISIT
}

enum AppointmentStatus {
  PENDING_PAYMENT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  REFUNDED
}

enum SessionMode {
  VIDEO
  HOME
  CHAT
  ANY
}

enum PaymentStatus {
  PENDING
  HELD
  RELEASED
  REFUNDED
  FAILED
}

enum LedgerEntryType {
  CHARGE
  HOLD
  RELEASE
  PLATFORM_FEE   // legacy — kept for existing rows; new code uses COMMISSION + SERVICE_FEE
  COMMISSION
  SERVICE_FEE
  VIDEO_ADDON
  PROCESSOR_FEE
  PHYSIO_PAYOUT
  REFUND
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VideoProviderName {
  DAILY
  IN_HOUSE
}

enum HomeVisitStatus {
  REQUESTED
  MATCHING
  SCHEDULED
  EN_ROUTE
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum FeedbackFormType {
  PATIENT_SESSION      // submitted by patient after each session
  SPECIALIST_SESSION   // submitted by specialist after each session
  PATIENT_END_OF_PILOT // submitted by patient at pilot end
  SPECIALIST_END_OF_PILOT // submitted by specialist at pilot end
}

enum NotificationChannel {
  EMAIL
  PUSH
  IN_APP
  SMS
}

// ── Identity ─────────────────────────────
model User {
  id              String     @id @default(uuid())
  role            Role
  email           String     @unique
  emailVerifiedAt DateTime?
  passwordHash    String
  name            String
  phone           String?
  status          UserStatus @default(PENDING)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  physioProfile   PhysioProfile?
  patientProfile  PatientProfile?
  emailTokens     EmailToken[]
  auditLogs       AuditLog[]

  sentMessages    Message[]  @relation("sender")
  patientThreads  Thread[]   @relation("patient")
  physioThreads   Thread[]   @relation("physio")
  feedback        SessionFeedback[]

  @@index([role, status])
}

model EmailToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  purpose   String   // "verify_email" | "reset_password"
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, purpose])
}

model PhysioProfile {
  userId          String        @id
  discipline      Discipline    @default(PHYSIOTHERAPY)
  licenceNo       String        @unique
  licensingBody   String?
  licenceStatus   LicenceStatus @default(UNVERIFIED)
  specialties     String[]
  bio             String
  rateKobo        Int           @default(0)  // set by admin, not by the professional
  serviceArea     String
  verifiedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  languages         String[]      @default([])
  photoUrl          String?
  sessionTypes      String[]      @default([])
  sessionMinutes    Int           @default(45)
  bufferMinutes     Int           @default(15)
  acceptingPatients  Boolean       @default(true)
  pilotParticipant   Boolean       @default(false)
  // Set when an admin explicitly confirms they cross-checked with MRTB before approving.
  mrtbCheckedAt      DateTime?

  // Identity & credential documents (URLs from Vercel Blob)
  licenceDocUrl     String?
  certificateUrl    String?
  idType            String?       // "NIN" | "DRIVERS_LICENSE" | "INTL_PASSPORT" | "VOTERS_CARD"
  ninNumber         String?       @unique  // ID number (NIN, licence, passport, or voter card)
  ninDocUrl         String?

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  availability      Availability[]
  appointments      Appointment[] @relation("physio_appointments")
  programs          Program[]
  referralsSent     Referral[]    @relation("referral_sender")
  referralsReceived Referral[]    @relation("referral_receiver")
  goalPlans         GoalPlan[]
  slotHolds         SlotHold[]
  daysOff           DayOff[]
  packages          Package[]
  withdrawals       Withdrawal[]

  @@index([licenceStatus])
  @@index([discipline, licenceStatus])
  @@index([acceptingPatients, licenceStatus])
}

model PatientProfile {
  userId            String   @id
  dob               DateTime?
  sex               String?
  location          String?
  emergencyContact  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  intakes           Intake[]
  appointments      Appointment[] @relation("patient_appointments")
  programs          Program[]
  dependents        Dependent[]
  goalPlans         GoalPlan[]
  referralsAsPatient Referral[]
  packages           Package[]
  walletEntries      WalletEntry[]
  fallbackCases      FallbackCase[]
}

// ── Caregiver / Dependents ────────────────
model Dependent {
  id           String         @id @default(uuid())
  caregiverId  String
  name         String
  dob          DateTime?
  sex          String?
  relationship String         // "child" | "sibling" | "parent" | "spouse" | "other"
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  caregiver    PatientProfile @relation(fields: [caregiverId], references: [userId], onDelete: Cascade)
  intakes      Intake[]       @relation("dependent_intakes")
  appointments Appointment[]  @relation("dependent_appointments")

  @@index([caregiverId])
}

// ── Intake & triage ──────────────────────
model Intake {
  id             String   @id @default(uuid())
  patientId      String
  dependentId    String?
  complaint      String
  bodyRegion     String
  onset          String
  painScore      Int
  history        String?
  medications    String?
  redFlagAnswers Json     // [{questionId, answer}]
  createdAt      DateTime @default(now())

  patient        PatientProfile @relation(fields: [patientId], references: [userId], onDelete: Cascade)
  dependent      Dependent?     @relation("dependent_intakes", fields: [dependentId], references: [id])
  triage         TriageResult?
  appointments   Appointment[]
  fallbackCase   FallbackCase?

  @@index([patientId])
}

model TriageResult {
  id            String      @id @default(uuid())
  intakeId      String      @unique
  level         TriageLevel
  reasons       String[]
  ruleIds       String[]
  overriddenBy  String?
  createdAt     DateTime    @default(now())

  intake        Intake      @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  @@index([level])
}

// ── Booking ──────────────────────────────
model Availability {
  id           String      @id @default(uuid())
  physioId     String
  weekday      Int
  startMinute  Int
  endMinute    Int
  mode         SessionMode
  createdAt    DateTime    @default(now())

  physio       PhysioProfile @relation(fields: [physioId], references: [userId], onDelete: Cascade)
  @@index([physioId, weekday])
}

// Temporarily holds a slot while the patient completes checkout.
// Expired holds are cleaned up by the SlotHoldExpiry BullMQ job.
model SlotHold {
  id            String    @id @default(uuid())
  physioId      String
  patientId     String
  startsAt      DateTime
  endsAt        DateTime
  expiresAt     DateTime
  appointmentId String?   @unique // set when the booking is confirmed

  physio        PhysioProfile @relation(fields: [physioId], references: [userId], onDelete: Cascade)

  @@index([physioId, startsAt])
  @@index([expiresAt])
}

// Single-day exceptions to a professional's recurring availability.
model DayOff {
  id       String        @id @default(uuid())
  physioId String
  date     DateTime      @db.Date
  reason   String?

  physio   PhysioProfile @relation(fields: [physioId], references: [userId], onDelete: Cascade)

  @@unique([physioId, date])
  @@index([physioId, date])
}

model Appointment {
  id             String            @id @default(uuid())
  patientId      String
  physioId       String
  dependentId    String?
  intakeId       String?
  type           AppointmentType
  mode           SessionMode
  startsAt       DateTime
  endsAt         DateTime
  status         AppointmentStatus @default(PENDING_PAYMENT)
  cancelledAt    DateTime?
  cancelReason   String?
  disputeAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  patient      PatientProfile @relation("patient_appointments", fields: [patientId], references: [userId])
  physio       PhysioProfile   @relation("physio_appointments", fields: [physioId], references: [userId])
  dependent    Dependent?      @relation("dependent_appointments", fields: [dependentId], references: [id])
  intake       Intake?         @relation(fields: [intakeId], references: [id])
  payment      Payment?
  videoSession VideoSession?
  notes          SessionNote?
  homeVisit      HomeVisit?
  review         Review?
  ledger         LedgerEntry[]
  referral           Referral?       @relation("referral_appointment")
  patientSummary     PatientSummary?
  packageSession     PackageSession?
  sessionExercises   SessionExercise[]
  feedback           SessionFeedback[]

  @@index([patientId, startsAt])
  @@index([physioId, startsAt])
  @@index([status])
  @@index([dependentId])
  @@index([intakeId])
}

// ── Pilot settings (singleton — id always = 1) ───────────────────────────────
model PilotSettings {
  id                     Int      @id @default(1)
  pilotModeEnabled       Boolean  @default(false)
  pilotStartDate         DateTime @default(dbgenerated("'2026-12-01 00:00:00'::timestamp"))
  pilotEndDate           DateTime @default(dbgenerated("'2027-03-01 00:00:00'::timestamp"))
  commissionBps          Int      @default(1000)
  serviceFeeBps          Int      @default(500)
  serviceFeeCapKobo      Int      @default(50000)
  freeIntroVideoSessions Int      @default(2)
  videoAddonKobo         Int      @default(50000)
  sessionTarget          Int      @default(200)
  updatedAt              DateTime @updatedAt
  updatedBy              String?

  @@map("pilot_settings")
}

// ── Payments ─────────────────────────────
model Payment {
  id                    String        @id @default(uuid())
  appointmentId         String        @unique
  amountKobo            Int
  walletAmountKobo      Int           @default(0)
  currency              String        @default("NGN")
  status                PaymentStatus @default(PENDING)
  providerRef           String?
  payoutRef             String?
  // Rate snapshot — values in effect at the moment of booking; never change after payment.
  commissionBpsPaid     Int?
  serviceFeeBpsPaid     Int?
  serviceFeeCapKoboPaid Int?
  videoAddonKoboPaid    Int?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  appointment           Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  entries               LedgerEntry[]

  @@index([status])
}

model LedgerEntry {
  id               String          @id @default(uuid())
  paymentId        String
  appointmentId    String
  type             LedgerEntryType
  amountKobo       Int
  balanceAfterKobo Int
  note             String?
  createdAt        DateTime        @default(now())

  payment          Payment         @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  appointment      Appointment     @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
  @@index([appointmentId])
}

model Withdrawal {
  id            String           @id @default(uuid())
  physioId      String
  amountKobo    Int
  status        WithdrawalStatus @default(PENDING)
  bankName      String
  accountNumber String
  accountName   String
  adminNote     String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  physio        PhysioProfile    @relation(fields: [physioId], references: [userId], onDelete: Cascade)

  @@index([physioId, createdAt])
  @@index([status])
}

// ── Sessions ─────────────────────────────
model VideoSession {
  id            String             @id @default(uuid())
  appointmentId String             @unique
  provider      VideoProviderName
  roomId        String
  startedAt     DateTime?
  endedAt       DateTime?
  quality       Json?

  appointment   Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

model SessionNote {
  id              String    @id @default(uuid())
  appointmentId   String    @unique
  subjective      String
  objective       String
  assessment      String
  plan            String
  outcomeMeasures Json      @default("{}")
  signedAt        DateTime?
  signedBy        String?   // userId of the signer
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  appointment     Appointment     @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  addenda         NoteAddendum[]
}

// Post-sign-off additions — the original note is never edited after signing.
model NoteAddendum {
  id       String      @id @default(uuid())
  noteId   String
  body     String
  addedBy  String      // userId
  addedAt  DateTime    @default(now())

  note     SessionNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  @@index([noteId, addedAt])
}

// Plain-language summary the professional writes for the patient after the session.
model PatientSummary {
  id            String      @id @default(uuid())
  appointmentId String      @unique
  body          String
  approvedAt    DateTime?   // set when the professional finalises it
  approvedBy    String?     // userId

  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

// ── Exercise library & programs ──────────
model Exercise {
  id                 String        @id @default(uuid())
  csvId              String?       @unique     // CSV id e.g. "UL-001" — set for every library exercise
  name               String
  category           String        @default("General")
  region             String
  joint              String?
  purpose            String?
  goal               String?
  conditions         String?
  position           String?
  howTo              String?
  dose               String?
  progression        String?
  precautions        String?
  equipment          String?
  videoStatus        String?
  poseKey            String?                   // key into poses.json (equals csvId for library exercises)
  poseData           Json?                     // admin-edited animation override; takes precedence over poses.json when set
  videoUrl           String?
  instructions       String?
  cues               String        @default("")
  contraindications  String?
  difficulty         Int           @default(1)
  defaultSets        Int           @default(3)
  defaultReps        Int           @default(10)
  defaultHoldSeconds Int           @default(0)
  clinicalReview     Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  programItems       ProgramItem[]
  sessionExercises   SessionExercise[]
  @@index([csvId])
  @@index([region, difficulty])
  @@index([clinicalReview])
  @@index([category])
}

model Program {
  id                String    @id @default(uuid())
  patientId         String
  physioId          String
  startsAt          DateTime
  endsAt            DateTime?
  status            String    @default("ACTIVE")
  version           Int       @default(1)
  dischargeSummary  String?
  maintenancePlan   String?
  createdAt         DateTime  @default(now())

  patient    PatientProfile @relation(fields: [patientId], references: [userId], onDelete: Cascade)
  physio     PhysioProfile   @relation(fields: [physioId], references: [userId])
  items      ProgramItem[]

  @@index([patientId, status])
}

model ProgramItem {
  id          String       @id @default(uuid())
  programId   String
  exerciseId  String
  sets        Int
  reps        Int
  holdSeconds Int          @default(0)
  frequency   String
  notes       String?
  createdAt   DateTime     @default(now())

  program     Program      @relation(fields: [programId], references: [id], onDelete: Cascade)
  exercise    Exercise     @relation(fields: [exerciseId], references: [id])
  logs        ExerciseLog[]

  @@index([programId])
}

model ExerciseLog {
  id            String   @id @default(uuid())
  programItemId String
  date          DateTime @db.Date
  completed     Boolean
  painAfter     Int?
  notes         String?
  createdAt     DateTime @default(now())

  programItem   ProgramItem @relation(fields: [programItemId], references: [id], onDelete: Cascade)
  @@unique([programItemId, date])
}

// In-session diagnostic exercise: physio sends during a live session for real-time movement testing.
// Diagnostic only — not added to the patient's home programme.
model SessionExercise {
  id            String    @id @default(uuid())
  appointmentId String
  exerciseId    String
  sentAt        DateTime  @default(now())

  // Patient feedback (filled after performing the movement)
  feel          String?   // easy | okay | painful
  painScore     Int?      // 0–10
  feedbackNote  String?
  feedbackAt    DateTime?

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  exercise    Exercise    @relation(fields: [exerciseId], references: [id])

  @@index([appointmentId])
  @@index([exerciseId])
}

// ── Messaging ────────────────────────────
model Thread {
  id         String    @id @default(uuid())
  patientId  String
  physioId   String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  patient    User      @relation("patient", fields: [patientId], references: [id], onDelete: Cascade)
  physio     User      @relation("physio", fields: [physioId], references: [id], onDelete: Cascade)
  messages   Message[]

  @@unique([patientId, physioId])
}

model Message {
  id         String   @id @default(uuid())
  threadId   String
  senderId   String
  body       String
  attachments Json    @default("[]")
  sentAt     DateTime @default(now())

  thread     Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender     User     @relation("sender", fields: [senderId], references: [id])

  @@index([threadId, sentAt])
}

// ── Home visits ──────────────────────────
model HomeVisit {
  id            String          @id @default(uuid())
  appointmentId String          @unique
  address       String
  lat           Float
  lng           Float
  status        HomeVisitStatus @default(REQUESTED)
  checkInAt     DateTime?
  checkOutAt    DateTime?
  createdAt     DateTime        @default(now())

  appointment   Appointment     @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

// ── Reviews & audit ──────────────────────
model Review {
  id            String   @id @default(uuid())
  appointmentId String   @unique
  rating        Int
  comment       String?
  createdAt     DateTime @default(now())

  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  entity    String
  entityId  String
  at        DateTime @default(now())

  actor     User?    @relation(fields: [actorId], references: [id])
  @@index([entity, entityId])
  @@index([actorId, at])
}

model WaitlistEntry {
  id           String   @id @default(uuid())
  kind         String   // "PATIENT" | "PROFESSIONAL"
  specialty    String?  // legacy; use discipline for new entries
  discipline   String?  // "PHYSIOTHERAPY" | "OCCUPATIONAL_THERAPY" | "SPEECH_THERAPY" | "PROSTHETICS" | "ORTHOTICS"
  licensingBody String?
  pilotTester  Boolean  @default(false)
  name         String
  email        String
  phone        String?
  city         String
  concern      String?  // patient's primary concern / "what do you need help with"
  licenceNo    String?  // professional's licence (optional)
  experience   String?  // professional's years of experience
  notes        String?
  createdAt    DateTime @default(now())

  @@index([kind, createdAt])
}

// ── Notifications ────────────────────────
model Notification {
  id        String              @id @default(uuid())
  userId    String
  channel   NotificationChannel
  subject   String
  body      String
  sentAt    DateTime?
  openedAt  DateTime?
  clickedAt DateTime?
  createdAt DateTime            @default(now())

  @@index([userId, createdAt])
}

// ── Referrals ─────────────────────────────
model Referral {
  id                  String          @id @default(uuid())
  fromProfessionalId  String
  toDiscipline        Discipline
  toProfessionalId    String?         // null = any available
  patientId           String
  reason              String
  urgency             ReferralUrgency
  status              ReferralStatus  @default(SENT)
  declineReason       String?
  summary             String?

  // Shared items: flags indicating what the sender chose to share
  shareAssessmentNote Boolean         @default(false)
  sharePlan           Boolean         @default(false)
  shareMessages       Boolean         @default(false)
  patientConsented    Boolean         @default(false)
  patientConsentedAt  DateTime?

  // Linked appointment (set when BOOKED)
  appointmentId       String?         @unique
  expiresAt           DateTime?

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  sender              PhysioProfile   @relation("referral_sender", fields: [fromProfessionalId], references: [userId])
  receiver            PhysioProfile?  @relation("referral_receiver", fields: [toProfessionalId], references: [userId])
  patient             PatientProfile  @relation(fields: [patientId], references: [userId])
  appointment         Appointment?    @relation("referral_appointment", fields: [appointmentId], references: [id])
  auditEntries        ReferralAudit[]

  @@index([fromProfessionalId, status])
  @@index([toProfessionalId, status])
  @@index([patientId])
  @@index([toDiscipline, status])
}

model ReferralAudit {
  id         String         @id @default(uuid())
  referralId String
  actorId    String?
  fromStatus ReferralStatus?
  toStatus   ReferralStatus
  note       String?
  at         DateTime       @default(now())

  referral   Referral       @relation(fields: [referralId], references: [id], onDelete: Cascade)

  @@index([referralId, at])
}

// ── Goal plans (OT, Speech therapy) ──────
model GoalPlan {
  id           String         @id @default(uuid())
  patientId    String
  professionalId String
  title        String
  status       String         @default("ACTIVE") // ACTIVE | COMPLETED | ARCHIVED
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  patient      PatientProfile @relation(fields: [patientId], references: [userId], onDelete: Cascade)
  professional PhysioProfile  @relation(fields: [professionalId], references: [userId])
  goals        Goal[]

  @@index([patientId, status])
  @@index([professionalId])
}

model Goal {
  id          String     @id @default(uuid())
  goalPlanId  String
  title       String
  status      GoalStatus @default(ACTIVE)
  progress    Int        @default(0)  // 0-100
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  goalPlan    GoalPlan   @relation(fields: [goalPlanId], references: [id], onDelete: Cascade)
  tasks       PracticeTask[]

  @@index([goalPlanId, status])
}

model PracticeTask {
  id          String   @id @default(uuid())
  goalId      String
  title       String
  schedule    String   // e.g. "daily", "3x/week", "Mon Wed Fri"
  notes       String?
  createdAt   DateTime @default(now())

  goal        Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  logs        TaskLog[]

  @@index([goalId])
}

model TaskLog {
  id             String      @id @default(uuid())
  practiceTaskId String
  date           DateTime    @db.Date
  completed      Boolean
  note           String?
  createdAt      DateTime    @default(now())

  task           PracticeTask @relation(fields: [practiceTaskId], references: [id], onDelete: Cascade)

  @@unique([practiceTaskId, date])
}

// ── Session packages ─────────────────────
// A prepaid bundle of follow-up sessions with a fixed physio.
// Discount: service fee waived (PACKAGE_DISCOUNT_MODE = "WAIVE_SERVICE_FEE").
model Package {
  id          String   @id @default(uuid())
  patientId   String
  physioId    String
  size        Int      // 3, 5, or 10 (from PACKAGE_SIZES)
  remaining   Int
  priceKobo   Int      // total price at purchase (no service fee)
  status      String   @default("ACTIVE") // ACTIVE | EXHAUSTED | EXPIRED
  expiresAt   DateTime
  purchasedAt DateTime @default(now())

  patient     PatientProfile @relation(fields: [patientId], references: [userId], onDelete: Cascade)
  physio      PhysioProfile  @relation(fields: [physioId],  references: [userId])
  sessions    PackageSession[]

  @@index([patientId, status])
  @@index([physioId])
}

// Each appointment redeemed against a package burns one session.
model PackageSession {
  id            String   @id @default(uuid())
  packageId     String
  appointmentId String   @unique
  redeemedAt    DateTime @default(now())

  package     Package     @relation(fields: [packageId],     references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([packageId])
}

// ── Licensing bodies config ───────────────
// Admin-editable list of recognised licensing bodies per discipline.
// Seeded with placeholders; Victor to confirm real bodies.
model LicensingBody {
  id         String     @id @default(uuid())
  discipline Discipline
  name       String
  country    String     @default("NG")
  active     Boolean    @default(true)
  createdAt  DateTime   @default(now())

  @@unique([discipline, name, country])
  @@index([discipline, active])
}

// ── Patient wallet ────────────────────────
// Append-only ledger of wallet credits and debits for each patient.
// Credits: refunds, manual top-ups.  Debits: session payments using wallet credit.
model WalletEntry {
  id            String          @id @default(uuid())
  patientId     String
  amountKobo    Int             // positive = credit, negative = debit
  type          WalletEntryType
  ref           String?         // Paystack reference (deposits) or appointmentId (refunds/debits)
  note          String?
  createdAt     DateTime        @default(now())

  patient       PatientProfile  @relation(fields: [patientId], references: [userId], onDelete: Cascade)

  @@index([patientId, createdAt])
  @@index([patientId, ref, type])
}

enum WalletEntryType {
  DEPOSIT
  REFUND_CREDIT
  SESSION_DEBIT
}

// ── Fallback cases ────────────────────────
// Patients triaged IN_PERSON_REQUIRED are logged here so the admin team
// can follow up and signpost them to appropriate in-person services.

enum FallbackCaseStatus {
  OPEN
  CONTACTED
  RESOLVED
  CLOSED
}

model FallbackCase {
  id          String             @id @default(uuid())
  intakeId    String             @unique
  patientId   String
  status      FallbackCaseStatus @default(OPEN)
  adminNote   String?
  resolvedAt  DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  intake      Intake             @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  patient     PatientProfile     @relation(fields: [patientId], references: [userId], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([patientId])
}

// ── Session feedback ─────────────────────────────────────────────────────────
// No patient names in exports — only appointment IDs and anonymised scores.
model SessionFeedback {
  id              String           @id @default(uuid())
  formType        FeedbackFormType
  appointmentId   String?          // null for end-of-pilot forms
  submittedById   String           // userId of patient or specialist
  // Session-level outcome measures (1–10)
  painScore       Int?
  functionScore   Int?
  // Ratings (1–5 stars)
  overallRating   Int?
  communicationRating Int?
  // Free-text — never logged, never in URLs
  whatWentWell    String?
  whatCouldImprove String?
  // End-of-pilot: would recommend?
  wouldRecommend  Boolean?
  createdAt       DateTime         @default(now())

  appointment     Appointment?     @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  submittedBy     User             @relation(fields: [submittedById], references: [id], onDelete: Cascade)

  @@index([formType, createdAt])
  @@index([appointmentId])
  @@index([submittedById])
}
