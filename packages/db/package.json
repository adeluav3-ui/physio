    "prisma": {
        "seed": "tsx prisma/seed.ts"
    },
    "devDependencies": {
        "prisma": "^6.0.1",
        "tsx": "^4.19.2",
        "typescript": "^5.6.3"
    },
    "dependencies": {
        "@prisma/client": "6.19.3"
    }
}